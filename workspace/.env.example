# ============================================================
# Family Face Recognition System — Environment Variables
# ============================================================
# Sao chép file này thành .env rồi điền giá trị thực:
#   cp .env.example .env
# File .env KHÔNG được commit lên git.
# ============================================================


# ------------------------------------------------------------
# TELEGRAM (bắt buộc nếu muốn nhận alert trên điện thoại)
# ------------------------------------------------------------
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID của bạn — lấy bằng cách:
#   1. Nhắn bot 1 tin bất kỳ
#   2. Mở: https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Tìm "chat" -> "id"
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------
# MQTT (chỉ cần nếu dùng smart home / Home Assistant)
# ------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=home/faces

# Để trống nếu MQTT broker không yêu cầu đăng nhập
MQTT_USERNAME=
MQTT_PASSWORD=


# ------------------------------------------------------------
# SERIAL / ARDUINO (chỉ cần nếu kết nối phần cứng)
# ------------------------------------------------------------
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=9600

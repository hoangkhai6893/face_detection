# ============================================================
# Family Face Recognition System — Environment Variables
# ============================================================
# Sao chép file này thành .env rồi điền giá trị thực:
#   cp .env.example .env
# File .env KHÔNG được commit lên git.
# ============================================================


# ------------------------------------------------------------
# TELEGRAM (bắt buộc nếu muốn nhận alert trên điện thoại)
# ------------------------------------------------------------
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID của bạn — lấy bằng cách:
#   1. Nhắn bot 1 tin bất kỳ
#   2. Mở: https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Tìm "chat" -> "id"
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------
# MQTT (chỉ cần nếu dùng smart home / Home Assistant)
# ------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=home/faces

# Để trống nếu MQTT broker không yêu cầu đăng nhập
MQTT_USERNAME=
MQTT_PASSWORD=


# ------------------------------------------------------------
# SERIAL / ARDUINO (chỉ cần nếu kết nối phần cứng)
# ------------------------------------------------------------
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=9600


# ============================================================
# PHASE 1 — Pi-Ready & 24/7 (copy block này vào .env khi deploy Pi)
# ============================================================

# Tắt cv2.imshow — bắt buộc khi Pi không có X server
HEADLESS=true

# Chỉ chạy full pipeline mỗi N frame khi ACTIVE (giảm CPU/nhiệt)
# NUC dev: 1 | Pi5: 2 | Pi4: 3
ACTIVE_PROCESS_EVERY=2

# Camera resolution thấp hơn để tiết kiệm RAM bandwidth
# NUC dev: 1280×720 | Pi5: 640×480
FRAME_WIDTH=640
FRAME_HEIGHT=480


# ============================================================
# PHASE 3 — YuNet + SFace backend (CHỈ bật sau khi Phase 2 validation PASS)
# ============================================================

# Đổi sang "sface" sau khi download model và validate_backends.py PASS
FACE_BACKEND=dlib

# Paths đến model ONNX (download từ OpenCV Zoo — xem PHASE3_YUNET_SFACE_MIGRATION.md)
# YUNET_MODEL_PATH=src/yolo/yunet_int8.onnx
# SFACE_MODEL_PATH=model/sface_int8.onnx

# Cosine distance thresholds cho SFace (retune sau Phase 4 trên data gia đình thật)
# SFACE_TOLERANCE=0.50
# SFACE_CONFUSION_MARGIN=0.08
